{
  "name": "@vasekzdvihal/azure-devops-mcp",
  "version": "0.3.0",
  "description": "MCP server for Azure DevOps (Server and Services) — PR review, releases, pipelines, and commit history.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "azure-devops-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure-devops",
    "claude",
    "claude-code",
    "pull-request"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasekzdvihal/azure-devops-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vasekzdvihal/azure-devops-mcp/issues"
  },
  "homepage": "https://github.com/vasekzdvihal/azure-devops-mcp#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/index.ts setup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.2.0",
    "azure-devops-node-api": "^15.1.2",
    "diff": "^9.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
